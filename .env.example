# ======================
# PLANTILLA DE CONFIGURACIÓN SENS
# Copia este archivo como .env.local y completa los valores
# ======================

# Información básica de la aplicación
VITE_APP_NAME="SENS Lighting"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Precisiones de Algoritmos Matemáticos para Decisiones Rápidas de Iluminación"

# URLs de la API
VITE_API_BASE_URL="http://localhost:3001/api"
VITE_WS_URL="ws://localhost:3001"

# Límites de seguridad
VITE_MAX_FILE_SIZE="10485760"
VITE_MAX_CALCULATIONS_PER_MINUTE="30"
VITE_SESSION_TIMEOUT="3600000"

# Contacto
VITE_SUPPORT_EMAIL="tu-email@sens-lighting.com"
VITE_CONTACT_PHONE="+1-555-SENS-123"

# Características
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_ERROR_REPORTING="false"

# Entorno
VITE_NODE_ENV="development"